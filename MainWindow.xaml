<Window x:Class="MRXRustTranslator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MRX Rust Translator" Height="720" Width="980" Background="#101310" Foreground="#F2F5EF"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="MRX RUST TRANSLATOR" FontSize="26" FontWeight="Bold" Foreground="#8DFF36"/><TextBlock Text="LIVE CHAT OCR • EN ↔ RU • WINDOWS 11" Foreground="#9BA598" Margin="0,5,0,15"/></StackPanel><WrapPanel Grid.Row="1" Background="#1A201A" Margin="0,0,0,14"><TextBlock Text="X" VerticalAlignment="Center"/><TextBox x:Name="XBox" Text="30" Width="55" Margin="5"/><TextBlock Text="Y" VerticalAlignment="Center"/><TextBox x:Name="YBox" Text="650" Width="55" Margin="5"/><TextBlock Text="W" VerticalAlignment="Center"/><TextBox x:Name="WBox" Text="650" Width="55" Margin="5"/><TextBlock Text="H" VerticalAlignment="Center"/><TextBox x:Name="HBox" Text="260" Width="55" Margin="5"/><Button Content="НАЧАТЬ OCR" Click="Start_Click" Padding="15,7" Background="#8DFF36"/><Button Content="СТОП" Click="Stop_Click" Padding="15,7" Margin="7,0"/><CheckBox x:Name="TopmostCheck" Content="Поверх окон" IsChecked="True" Checked="Topmost_Changed" Unchecked="Topmost_Changed" VerticalAlignment="Center"/></WrapPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#171C17" CornerRadius="9" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ИГРОВОЙ ЧАТ / ПЕРЕВОД" Foreground="#8DFF36" FontWeight="Bold" Margin="0,0,0,10"/><ScrollViewer><ItemsControl x:Name="ChatItems"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202820" Padding="8" Margin="0,0,0,7" CornerRadius="6"><StackPanel><TextBlock Text="{Binding Original}" TextWrapping="Wrap" Foreground="#BBC5B7"/><TextBlock Text="{Binding Translated}" TextWrapping="Wrap" Foreground="#8DFF36" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border><Border Grid.Column="2" Background="#171C17" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="РУЧНОЙ ПЕРЕВОД RU → EN" Foreground="#8DFF36" FontWeight="Bold" Margin="0,0,0,10"/><TextBox x:Name="OutgoingBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap"/><Button Content="ПЕРЕВЕСТИ" Click="TranslateOutgoing_Click" Margin="0,8" Padding="8" Background="#8DFF36"/><TextBlock Text="АНГЛИЙСКИЙ ТЕКСТ" Foreground="#9BA598"/><TextBox x:Name="ResultBox" Height="130" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/><Button Content="КОПИРОВАТЬ" Click="Copy_Click" Margin="0,8" Padding="8"/><TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="#9BA598" TextWrapping="Wrap" Margin="0,8"/></StackPanel></Border></Grid></Grid></Window>